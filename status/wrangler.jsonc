{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tenmei-mori-status",
  "compatibility_date": "2026-09-29",
  "pages_build_output_dir": "./dist",
  "vars": {
    "CRON_CHECK_INTERVAL": "1",
    "DISCORD_STATUS_ALERT_URL": "https://tenmei-discord-bot.nden14800.workers.dev/internal/status-alert",
    "MONITOR_USER_AGENT": "tenmei-mori-uptimeworker/1.0",
    "VITE_ALLOWED_LANGS": "ja,en",
    "VITE_HISTORY_DAYS": "30",
    "VITE_REFRESH_INTERVAL": "60",
    "VITE_STATUS_TITLE": "運勢・天命乃杜 — Status"
  }
}