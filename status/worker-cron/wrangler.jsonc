{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tenmei-mori-uptimeworker-cron",
  "main": "./worker.js",
  "compatibility_date": "2026-09-29",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "logs": {
      "invocation_logs": true,
      "head_sampling_rate": 1
    }
  },
  "triggers": {
    "crons": ["* * * * *"]
  }
}
