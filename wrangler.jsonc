{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tenmei-mori",
  "compatibility_date": "2026-09-29",
  "pages_build_output_dir": ".",
  "vars": {
    "CRON_CHECK_INTERVAL": "1",
    "DISCORD_STATUS_ALERT_URL": "https://tenmei-discord-bot.nden14800.workers.dev/internal/status-alert",
    "MONITOR_USER_AGENT": "tenmei-mori-uptimeworker/1.0"
  },
  "services": [
    {
      "binding": "STATUS_STORE",
      "service": "tenmei-mori-status-store",
      "environment": "production"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV_STATUS_PAGE",
      "id": "cf5217d1e62149d3ae751996cd62c28e"
    }
  ]
}
